#include <stdio.h>
#include <string.h> 

int main() {
    
    char estado1, estado2;
    char codigo_carta1[4], codigo_carta2[4];
    char nome_cidade1[40], nome_cidade2[40];
    int populacao1, populacao2;
    float area_cidade1, area_cidade2;
    float pib1, pib2;
    int pontotur1, pontotur2;

    printf("Olá Jogador\n Bem vindo ao Super Trunfo.\n");

    //Cadastro da Carta numero 1
    printf("\nCadastro da Carta 1\n\n");
    printf("Digite o Estado:(de A a H)\n");//Jogo mostra uma mensagem na tela do Jogador
    scanf(" %c", &estado1);//Função em que o Jogador insere os dados pedidos(Estado)

    
    printf("Digite o código da carta:(ex:A01)\n");
    scanf(" %3s", codigo_carta1);//Espaço em branco após as aspas para o programa não fechar

    printf("Digite o nome da Cidade:");
    scanf(" %s[^\n]", nome_cidade1);//Espaço em branco após as aspas

    printf("Digite a populacao:\n");
    scanf("%d", &populacao1);

    printf("Digite a Area da cidade:\n");
    scanf("%f", &area_cidade1);

    printf("Digite o Pib da cidade:\n");
    scanf("%f", &pib1);

    printf("Digite quantos pontos turisticos tem a cidade:\n");
    scanf("%d", &pontotur1);

    //Exibe os Dados da Carta 1
    printf("Código da Carta: %s - Estado: %c\n", codigo_carta1, estado1);
    printf("Cidade: %s - População: %d\n", nome_cidade1, populacao1);
    printf("Area: %.2f - Pib: %.2f - Pontos Turisticos: %d\n", area_cidade1, pib1, pontotur1);
  

   //Cadastro Carta número 2
   printf("Cadastro da Carta 2\n");
   printf("Digite o Estado:(de A a H)\n");
   scanf(" %c", &estado2);

   printf("Digite o código da carta:(ex:A01)\n");
   scanf(" %3s", codigo_carta2);

   printf("Digite o nome da Cidade:");
   scanf(" %s[^\n]", nome_cidade2);

   printf("Digite a populacao:\n");
   scanf("%d", &populacao2);

   printf("Digite a Area da cidade:\n");
   scanf(" %f", &area_cidade2);

   printf("Digite o Pib da cidade:\n");
   scanf(" %f", &pib2);

   printf("Digite quantos pontos turisticos tem a cidade:\n");
   scanf("%d", &pontotur2);

   //Exibe os Dados da Carta 2
   printf("Código da Carta: %s - Estado: %c\n", codigo_carta2, estado2);
   printf("Cidade: %s - População: %d\n", nome_cidade2, populacao2);
   printf("Area: %.2f - Pib: %.2f - Pontos Turisticos: %d\n", area_cidade2, pib2, pontotur2);


    return 0;
}
